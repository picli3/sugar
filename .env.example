# Optional overrides for compose.yaml. Copy to .env before starting if needed.
APP_PORT=127.0.0.1:8088
# Optional canonical browser origin (scheme + host + port, no path). Production Compose defaults to its HTTPS domain.
PUBLIC_ORIGIN=
DB_PASSWORD=replace-with-a-long-random-password
# Separate runtime DB password: generate 32 random bytes as 64 hex characters; never reuse DB_PASSWORD.
RUNTIME_DB_PASSWORD=
ADMIN_EMAIL=admin@local
# Required before first boot (12+ characters, <=72 UTF-8 bytes). No password is generated or printed.
ADMIN_PASSWORD=
# Optional (>=32 UTF-8 bytes if set). When empty, a stable random signing secret is stored in PostgreSQL.
JWT_SECRET=
# Optional GitHub App installation. Use literal \n between private-key lines.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_PRIVATE_KEY=

# Required to save AI tokens: generate once with openssl rand -hex 32. Keep it with backups.
AI_ENCRYPTION_KEY=

# API processes also accept *_FILE for ADMIN_PASSWORD, JWT_SECRET, AI_ENCRYPTION_KEY,
# GITHUB_PRIVATE_KEY and DATABASE_URL. Files must be regular, owned by root/API UID,
# mode 0400/0600, with no symlinks. Do not set both value and *_FILE.
# Mount the private files explicitly; the default Compose continues using .env.

# Public registration stays OFF until explicit approval and all public-readiness blockers pass.
REGISTRATION_ENABLED=false
# Required only when enabling registration: SMTP submission with verified TLS (587 STARTTLS or 465 TLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_PASSWORD_FILE is also supported by the API (same protected-file rules as above).
# Independent AES-256-GCM key for SMTP passwords saved by Admin. Generate once with openssl rand -hex 32.
# Keep this key with backups; do not reuse AI_ENCRYPTION_KEY. MAIL_ENCRYPTION_KEY_FILE is also supported.
MAIL_ENCRYPTION_KEY=

# Independently enable verified-email recovery and secure email changes after owner approval.
ACCOUNT_RECOVERY_ENABLED=false

# Optional Admin MFA enrollment stays OFF until recovery/UI validation and owner approval.
# Dedicated AES-256-GCM key: generate once with openssl rand -hex 32; never reuse AI/mail keys.
# Keep separately encrypted with backups. MFA_ENCRYPTION_KEY_FILE is supported with the file rules above.
MFA_ENCRYPTION_KEY=
MFA_ENROLLMENT_ENABLED=false
# Disabling enrollment does not disable an existing factor; login/recovery remain enforced.
